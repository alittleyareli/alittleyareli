<div class="flex flex-col flex-wrap justify-center w-full h-full">
  <div class="flex-none">
    <h3 class="w-full text-sm font-bold uppercase fg-i bg-i p-1 mb-2">Recent Posts</h3>
  </div>

  <div class="flex-1">
    {% assign posts = posts |  reverse %}
    {% for post in posts limit:limit %}
      <div class="mb-2 sm:mb-4">
        <div class="text-xxs type uppercase">{{ post.date | date: "%Y-%m-%d"  }}</div>
        <a class="link fg" href="{{ post.url }}">{{ post.data.title  }}</a>
      </div>
    {% endfor %}
  </div>

  {% unless url == "/pages/archive/" %}
    <div class="flex-none mt-auto">
      <a class="link text-xxs type font-bold uppercase" href="/pages/archive/">See Full Archive &gt;&gt;</a>
    </div>
  {% endunless %}
</div>
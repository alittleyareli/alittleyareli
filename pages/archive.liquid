---
title: archive • yareli's press
layout: main
---
<script src="/content/pagefind/pagefind.js"></script>
<script src="/content/pagefind/pagefind-ui.js"></script>

<div class="grid grid-cols-1 sm:grid-cols-4 gap-2">
  <div class="col-span-1 sm:col-span-3">
    <div id="search-container" class="w-full h-full p-2 border bc bg overflow-y-scroll">
      <h3 class="w-full text-sm font-bold uppercase fg-i bg-i p-1 mb-4">Search the Archive</h3>

      <div id="search" class="w-full"></div>
      <script src="/content/scripts/mount.js" defer></script>
    </div>
  </div>

  <div class="col-span-1">
    <div class="w-full h-full p-2 border bc bg">
      {% render "_includes/posts.liquid", posts: collections.post, limit: 5, url: page.url %}
    </div>
  </div>

  <div class="col-span-1 sm:col-span-4">
    <div class="w-full h-full p-2 border bc bg">
      <h3 class="w-full text-sm font-bold uppercase fg-i bg-i p-1 mb-2">Full Index</h3>

      {% assign posts = collections.post | reverse %}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 grid-flow-row w-full gap-x-2 gap-y-4">
        {% for post in posts %}
          <div class="col-auto">
            <div class="text-xxs type uppercase">{{ post.date | date: "%Y-%m-%d"  }}</div>
            <a class="link fg" href="{{ post.url }}">{{ post.data.title  }}</a>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>